# ==============================================================================
# SELENE-GRID v2.0 Runtime Configuration Template
# Autonomous Earth-to-Lunar Carbon-Aware Distributed AI Orchestrator
# ==============================================================================

# Google Gemini API (Used by Neuro-Symbolic AST Green Compiler)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"
NEXT_PUBLIC_GEMINI_API_KEY="your_google_gemini_api_key_here"

# Nebius Token Factory (OpenAI SDK Compatible - Meta-Llama-3.1-70B)
# Obtain from: https://studio.nebius.ai/
NEBIUS_API_KEY="your_nebius_api_key_here"
NEXT_PUBLIC_NEBIUS_API_KEY="your_nebius_api_key_here"
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEXT_PUBLIC_NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"

# Hugging Face Access Token
# Obtain from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="your_huggingface_token_here"
NEXT_PUBLIC_HUGGINGFACE_API_KEY="your_huggingface_token_here"

# Tiger Data / TimescaleDB Target
# PostgreSQL connection string with TimescaleDB hypertable extensions
DATABASE_URL="postgresql://user:password@tigerdata-cluster.us-east-1.tsdb.cloud:5432/selene_grid"

# Solana Devnet Cluster RPC
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
